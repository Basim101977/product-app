# Example only. The app does NOT automatically load a root .env file.
# Browser public Firebase configuration is in netlify_site/runtime-config.js.
# Do not put passwords, refresh tokens, private keys, or service-account JSON here.

# Optional server runtime identity override; production fallback is pinned in source.
HATHIR_RUNTIME_SERVICE_ACCOUNT=

# Optional portable test paths; support/run-tests.cjs resolves its local npm dependencies.
PLAYWRIGHT_MODULE=
CHROME_PATH=
NAME_QR_GENERATOR_JS=
NAME_QR_DECODER_JS=
PERSONAL_TEST_JAVA=
PERSONAL_TEST_FIRESTORE_JAR=

# Explicit release guard, NOT a credential. Keep unset until an approved deployment.
HATHIR_PRODUCTION_RELEASE=

# No portable account secret is required: authenticate Firebase CLI interactively.
# GOOGLE_APPLICATION_CREDENTIALS is intentionally NOT set for local tests.
