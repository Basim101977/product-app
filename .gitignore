# Local credentials, production backup pointers and Firebase working files.
**/.private/
**/.firebase/
**/*-debug.log
**/*-debug.*.log
**/node_modules/

# Handover allowlist: original working copies and private/media archives stay local.
/*
!/.gitignore
!/.env.example
!/AGENTS.md
!/README.md
!/app/
!/support/
!/legacy/
!/tools/
!/handover/

**/venv/
**/.venv/
**/build/
**/dist/
**/.env
**/.env.*
!**/.env.example
**/__pycache__/
**/*.pyc
**/*.log
**/*.zip
**/*.enc
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/runtime/
**/test-results/
**/playwright-report/
/app/reports/
/support/reports/
/support/output/
/support/verification/
**/*.mp4
**/*.mp3
**/*.wav
**/*.webm
**/*.jar
